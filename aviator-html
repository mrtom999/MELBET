<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Melbet - Aviator Gameplay</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #0f141c;
            color: #ffffff;
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }
        .header {
            width: 100%;
            background: #18222d;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-sizing: border-box;
            border-bottom: 1px solid #223041;
        }
        .logo-text {
            font-size: 24px;
            font-weight: bold;
            color: #ff0000;
            letter-spacing: 2px;
        }
        .balance-box {
            background: #223041;
            padding: 8px 15px;
            border-radius: 5px;
            font-size: 14px;
            color: #e6c619;
            font-weight: bold;
        }
        .game-container {
            width: 90%;
            max-width: 600px;
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .stage {
            width: 100%;
            height: 300px;
            background: #18222d;
            border-radius: 12px;
            border: 1px solid #223041;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .multiplier {
            font-size: 48px;
            font-weight: bold;
            color: #ffffff;
            z-index: 2;
        }
        .plane {
            position: absolute;
            font-size: 40px;
            display: none;
            z-index: 1;
        }
        .status-text {
            position: absolute;
            bottom: 20px;
            font-size: 16px;
            color: #8b9bb4;
            font-weight: bold;
        }
        .control-panel {
            background: #18222d;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #223041;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        label {
            font-size: 14px;
            color: #8b9bb4;
        }
        input {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            border: 1px solid #223041;
            border-radius: 5px;
            background: #223041;
            color: white;
            outline: none;
            box-sizing: border-box;
        }
        input:focus {
            border-color: #ff0000;
        }
        .bet-btn {
            width: 100%;
            padding: 14px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }
        .bet-btn:hover {
            background-color: #218838;
        }
        .cashout-btn {
            width: 100%;
            padding: 14px;
            background-color: #ffc107;
            color: #000;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            display: none;
        }
        .cashout-btn:hover {
            background-color: #e0a800;
        }
        .back-link {
            text-align: center;
            margin-top: 10px;
        }
        .back-link a {
            color: #8b9bb4;
            text-decoration: none;
            font-size: 14px;
        }
        .back-link a:hover {
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-text">MELBET</div>
        <div class="balance-box">Balance: ৳ <span id="userBalance">0.00</span></div>
    </div>

    <div class="game-container">
        
        <div class="stage">
            <div id="plane" class="plane">✈️</div>
            <div id="multiplierDisplay" class="multiplier">1.00x</div>
            <div id="statusText" class="status-text">Place your bet to play</div>
        </div>

        <div class="control-panel">
            <div class="form-group">
                <label>Bet Amount (BDT)</label>
                <input type="number" id="betAmount" placeholder="Enter amount" min="10" value="100">
            </div>

            <button id="actionBtn" class="bet-btn" onclick="placeBet()">BET</button>
        </div>

        <div class="back-link">
            <a href="aviator.html">← Back to Lobby</a>
        </div>
    </div>

    <script>
        let balance = parseFloat(localStorage.getItem('userBalance')) || 0;
        document.getElementById('userBalance').innerText = balance.toFixed(2);

        let currentMultiplier = 1.00;
        let gameInterval = null;
        let crashPoint = 1.00;
        let isPlaying = false;
        let currentBet = 0;

        function updateBalanceUI() {
            document.getElementById('userBalance').innerText = balance.toFixed(2);
            localStorage.setItem('userBalance', balance.toFixed(2));
        }

        function placeBet() {
            let amountInput = document.getElementById('betAmount').value;
            currentBet = parseFloat(amountInput);

            if (isNaN(currentBet) || currentBet <= 0) {
                alert("Please enter a valid bet amount!");
                return;
            }

            if (currentBet > balance) {
                alert("Insufficient balance! Please deposit first.");
                return;
            }

            balance -= currentBet;
            updateBalanceUI();

            isPlaying = true;
            currentMultiplier = 1.00;
            crashPoint = (Math.random() * 3 + 1.20).toFixed(2);

            let actionBtn = document.getElementById('actionBtn');
            actionBtn.innerText = "CASH OUT";
            actionBtn.className = "cashout-btn";
            actionBtn.style.display = "block";
            actionBtn.setAttribute("onclick", "cashOut()");

            document.getElementById('plane').style.display = "block";
            document.getElementById('statusText').innerText = "Flying...";

            gameInterval = setInterval(() => {
                currentMultiplier += 0.04;
                document.getElementById('multiplierDisplay').innerText = currentMultiplier.toFixed(2) + "x";

                if (currentMultiplier >= crashPoint) {
                    crashGame();
                }
            }, 100);
        }

        function cashOut() {
            if (!isPlaying) return;

            clearInterval(gameInterval);
            let winnings = currentBet * currentMultiplier;
            balance += winnings;
            updateBalanceUI();

            document.getElementById('statusText').innerText = `Won ৳${winnings.toFixed(2)}!`;
            document.getElementById('multiplierDisplay').style.color = "#28a745";

            resetGameButton();
        }

        function crashGame() {
            clearInterval(gameInterval);
            isPlaying = false;

            document.getElementById('statusText').innerText = "Flew Away! (Crashed)";
            document.getElementById('multiplierDisplay').style.color = "#ff4d4d";
            document.getElementById('plane').style.display = "none";

            resetGameButton();
        }

        function resetGameButton() {
            isPlaying = false;
            let actionBtn = document.getElementById('actionBtn');
            actionBtn.innerText = "BET";
            actionBtn.className = "bet-btn";
            actionBtn.setAttribute("onclick", "placeBet()");

            setTimeout(() => {
                document.getElementById('multiplierDisplay').style.color = "#ffffff";
                document.getElementById('multiplierDisplay').innerText = "1.00x";
                document.getElementById('statusText').innerText = "Place your bet to play";
            }, 3000);
        }
    </script>

</body>
</html>
